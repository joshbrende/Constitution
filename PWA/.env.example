# Dev uses Vite proxy to localhost:8081 — leave default unless overriding.
VITE_API_BASE_URL=/api/v1

# Optional: override Reverb host when app-config points at localhost but you open the PWA from a phone on LAN.
# If unset, the PWA auto-uses window.location.hostname when config says localhost.
# VITE_REVERB_HOST=192.168.1.156
# VITE_REVERB_PORT=8090
# VITE_REVERB_SCHEME=http
