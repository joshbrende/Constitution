# Copy this file to `.env` in the repository root (same folder as `docker-compose.yml`).
# Docker Compose reads that `.env` for ${VAR} substitution in docker-compose.yml.
# The file `.env` is gitignored — never commit real production secrets.
#
# Example values suit local development only. Use strong, unique values in production.

DB_PASSWORD=constitution
MYSQL_PASSWORD=constitution
MYSQL_ROOT_PASSWORD=rootpassword

# Optional — override docker-compose defaults for app/queue (see docker-compose.yml environment).
# If unset, Compose uses http://localhost:8081 for local dev.
# APP_URL=https://staging.example.org
# CORS_ALLOWED_ORIGINS=https://staging.example.org

# Dialogue realtime (Laravel Reverb) — WebSocket port exposed from docker-compose `reverb` service.
# For a phone on the same LAN, set REVERB_CLIENT_HOST to your PC's LAN IP (not localhost).
REVERB_CLIENT_HOST=localhost
REVERB_PORT=8090
REVERB_SCHEME=http
REVERB_APP_ID=constitution
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
