APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081

# Browser clients (mobile web, Scribe Try It Out). Comma-separated origins.
# Docker default: http://localhost:8081
CORS_ALLOWED_ORIGINS=http://localhost:8081

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Optional: plain password for seeded admin@zanupf.org.zw (User model hashes it). If empty, AdminUserSeeder skips.
# Never use a production secret in committed examples; set only in local/staging .env.
ADMIN_SEED_PASSWORD=

# Optional: password for seeded mobile.test@zanupf.org.zw (MobileTestUserSeeder). Default: MobileTest123!
MOBILE_TEST_PASSWORD=

# Phase 1 pilot provincial admins (Harare + Bulawayo) — ProvincialPilotSeeder
PILOT_ADMIN_PASSWORD=
PILOT_PUBLIC_SITE_URL=http://localhost:8081
PILOT_PRESIDIUM_EMAIL=presidium.pilot@zanupf.org.zw

# Optional bearer token for `php artisan scribe:generate` response calls (authenticated GET endpoints).
SCRIBE_AUTH_KEY=
SCRIBE_TRY_IT_OUT=true
ACCESS_TOKEN_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=7

# Password reset: link validity (minutes) and min seconds between new reset emails per address.
AUTH_PASSWORD_RESET_EXPIRE_MINUTES=60
AUTH_PASSWORD_RESET_THROTTLE_SECONDS=60

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
# Production: use LOG_LEVEL=info or warning to avoid debug noise; LOG_STACK=daily for rotation (see LOG_DAILY_DAYS).
# Alerts: add Slack Incoming Webhook to log errors (and optional separate ops ping):
# LOG_STACK=daily,slack
# LOG_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# LOG_SLACK_LEVEL=error
# OPS_ALERT_SLACK_WEBHOOK_URL=  (optional; defaults to LOG_SLACK_WEBHOOK_URL for queue-health failures)
# Optional Sentry (after: composer require sentry/sentry-laravel): SENTRY_LARAVEL_DSN=

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Production: set SESSION_ENCRYPT=true
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb

REVERB_APP_ID=constitution
REVERB_APP_KEY=local-reverb-key
REVERB_APP_SECRET=local-reverb-secret
REVERB_HOST=localhost
REVERB_CLIENT_HOST=localhost
REVERB_PORT=8090
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Docker Compose: use redis and run the `queue` service (see docker-compose.yml).
# QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@example.org.zw"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Optional: version badge on Admin → Documentation (defaults to 1.0.0 in config/admin_guide.php)
# APP_DOC_VERSION=1.0.0

# First-run wizard: required in production (pass ?setup_token=... or X-Setup-Token header).
SETUP_ACCESS_TOKEN=

# Comma-separated hostnames the backend is permitted to call.
# Example: INTEGRATION_ALLOWLIST_HOSTS=idm.gov.local,gateway.gov.local,hr.gov.local
INTEGRATION_ALLOWLIST_HOSTS=
# Default timeout for outbound internal service calls
INTEGRATION_HTTP_TIMEOUT_SECONDS=10

# Zimbabwe Govt portal (internal) — National ID verification (stub)
GOV_ID_PORTAL_BASE_URL=
# If true, membership-granting course enrolment requires verified national ID (once portal is implemented).
GOV_ID_ENFORCE_MEMBERSHIP_VERIFICATION=false

# Web Push (VAPID) for PWA — run: php artisan webpush:vapid
WEBPUSH_ENABLED=true
WEBPUSH_SUBJECT=mailto:support@zanupf.org.zw
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=

# Expo push (mobile app)
EXPO_PUSH_ENABLED=true
EXPO_PUSH_API_URL=https://exp.host/--/api/v2/push/send
